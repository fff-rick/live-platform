# 复制为 runtime.env 后，替换所有占位值；runtime.env 已被 .gitignore 忽略。
# 密码建议使用足够长的随机值，并避免 @、:、/ 等会影响 MYSQL_DSN 解析的字符。
MYSQL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_MYSQL_ROOT_PASSWORD
MIGRATION_MYSQL_DSN=root:REPLACE_WITH_A_LONG_RANDOM_MYSQL_ROOT_PASSWORD@tcp(mysql:3306)/live?parseTime=true&charset=utf8mb4

IDENTITY_MYSQL_APP_PASSWORD=REPLACE_WITH_IDENTITY_APP_PASSWORD
IDENTITY_MYSQL_MIGRATION_PASSWORD=REPLACE_WITH_IDENTITY_MIGRATION_PASSWORD
IDENTITY_MYSQL_AUDIT_PASSWORD=REPLACE_WITH_IDENTITY_AUDIT_PASSWORD
ROOM_MYSQL_APP_PASSWORD=REPLACE_WITH_ROOM_APP_PASSWORD
ROOM_MYSQL_MIGRATION_PASSWORD=REPLACE_WITH_ROOM_MIGRATION_PASSWORD
ROOM_MYSQL_AUDIT_PASSWORD=REPLACE_WITH_ROOM_AUDIT_PASSWORD
COMMERCE_MYSQL_APP_PASSWORD=REPLACE_WITH_COMMERCE_APP_PASSWORD
COMMERCE_MYSQL_MIGRATION_PASSWORD=REPLACE_WITH_COMMERCE_MIGRATION_PASSWORD
COMMERCE_MYSQL_AUDIT_PASSWORD=REPLACE_WITH_COMMERCE_AUDIT_PASSWORD
ARCHIVE_MYSQL_APP_PASSWORD=REPLACE_WITH_ARCHIVE_APP_PASSWORD
ARCHIVE_MYSQL_MIGRATION_PASSWORD=REPLACE_WITH_ARCHIVE_MIGRATION_PASSWORD
ARCHIVE_MYSQL_AUDIT_PASSWORD=REPLACE_WITH_ARCHIVE_AUDIT_PASSWORD
QUERY_MYSQL_APP_PASSWORD=REPLACE_WITH_QUERY_APP_PASSWORD
QUERY_MYSQL_MIGRATION_PASSWORD=REPLACE_WITH_QUERY_MIGRATION_PASSWORD
QUERY_MYSQL_AUDIT_PASSWORD=REPLACE_WITH_QUERY_AUDIT_PASSWORD

IDENTITY_MYSQL_DSN=live_identity_app:REPLACE_WITH_IDENTITY_APP_PASSWORD@tcp(mysql:3306)/identity?parseTime=true&charset=utf8mb4
ROOM_MYSQL_DSN=live_room_app:REPLACE_WITH_ROOM_APP_PASSWORD@tcp(mysql:3306)/room?parseTime=true&charset=utf8mb4
COMMERCE_MYSQL_DSN=live_commerce_app:REPLACE_WITH_COMMERCE_APP_PASSWORD@tcp(mysql:3306)/commerce?parseTime=true&charset=utf8mb4
ARCHIVE_MYSQL_DSN=live_archive_app:REPLACE_WITH_ARCHIVE_APP_PASSWORD@tcp(mysql:3306)/archive?parseTime=true&charset=utf8mb4
QUERY_MYSQL_DSN=live_query_audit:REPLACE_WITH_QUERY_AUDIT_PASSWORD@tcp(mysql:3306)/query?parseTime=true&charset=utf8mb4
QUERY_WRITER_MYSQL_DSN=live_query_app:REPLACE_WITH_QUERY_APP_PASSWORD@tcp(mysql:3306)/query?parseTime=true&charset=utf8mb4

CENTRIFUGO_API_KEY=REPLACE_WITH_A_LONG_RANDOM_API_KEY
CENTRIFUGO_TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_TOKEN_SECRET
AUTH_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_JWT_SECRET
REDIS_PASSWORD=
