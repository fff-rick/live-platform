# 复制为 runtime.env 后，替换所有占位值；runtime.env 已被 .gitignore 忽略。
# 密码建议使用足够长的随机值，并避免 @、:、/ 等会影响 MYSQL_DSN 解析的字符。
MYSQL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_MYSQL_ROOT_PASSWORD
MYSQL_DSN=live:REPLACE_WITH_A_LONG_RANDOM_MYSQL_PASSWORD@tcp(mysql:3306)/live?parseTime=true&charset=utf8mb4

CENTRIFUGO_API_KEY=REPLACE_WITH_A_LONG_RANDOM_API_KEY
CENTRIFUGO_TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_TOKEN_SECRET
AUTH_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_JWT_SECRET
