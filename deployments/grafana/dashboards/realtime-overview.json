      "targets": [
        {
          "refId": "A",
          "expr": "centrifugo_node_num_clients",
          "legendFormat": "{{service}}{{result}}{{topic}}{{group}}{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
